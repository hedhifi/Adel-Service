# Local Postgres started by `docker compose up -d --wait`.
DATABASE_URL=postgres://adel:adel@localhost:5432/adel

# Used by `pnpm test`. Docker Compose creates this database on first start.
TEST_DATABASE_URL=postgres://adel:adel@localhost:5432/adel_test

# At least 16 characters. Changing it signs everyone out and invalidates API tokens.
SESSION_SECRET=replace-with-a-long-random-string

APP_URL=http://localhost:3000

# Books live in Adel Service. Leave this unset. The only optional plug-in is QuickBooks,
# and it stays off until this is quickbooks. See docs/books.md.
# ACCOUNTING_PROVIDER=none
# QuickBooks plug-in. Sandbox or the built-in mock only. Live keys and the production host are refused.
# Ignored unless ACCOUNTING_PROVIDER=quickbooks.
# QBO_ENVIRONMENT=sandbox
# QBO_PROVIDER=mock
# QBO_CLIENT_ID=
# QBO_CLIENT_SECRET=
# QBO_REDIRECT_URI=http://localhost:3000/api/v1/qbo/oauth/callback

# Stripe TEST mode only. Live keys (sk_live_ / pk_live_) are refused.
# Dashboard: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Photo uploads. Relative paths are from the repo root when you run pnpm from there.
UPLOAD_DIR=data/uploads

# Optional. Create a token in Settings → API tokens, then:
# ADEL_API_BASE=http://localhost:3000
# ADEL_API_TOKEN=adel_...

# Dictation cleanup. The key stays in the environment and is never committed.
# Without a key, or when the value contains "replace", or when SPEECH_CLEANUP=off,
# the server skips the model. Dictionary spellings are still corrected, and the
# field stores the speech-engine transcript so Show original still works.
# SPEECH_CLEANUP=on
# SPEECH_CLEANUP_PROVIDER=openai
# SPEECH_CLEANUP_API_KEY=replace-with-a-provider-key
# SPEECH_CLEANUP_MODEL=gpt-4o-mini
# SPEECH_CLEANUP_BASE_URL=https://api.openai.com/v1
# Alternate provider: SPEECH_CLEANUP_PROVIDER=anthropic (uses the Anthropic messages API).
