# Copy to .env for local development. Never commit .env.
# Hosted installs set these in the provider's secret store. Do not bake them into the image.

# Local Postgres started by `docker compose up -d --wait`.
# On a host, use the managed connection string (sslmode=require when the provider requires it).
DATABASE_URL=postgres://adel:adel@localhost:5432/adel

# Used by `pnpm test`. Docker Compose creates this database on first start.
TEST_DATABASE_URL=postgres://adel:adel@localhost:5432/adel_test

# At least 16 characters. Changing it signs everyone out and invalidates API tokens.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string

# Public origin. Production (ADEL_SERVER=1) requires https://.
APP_URL=http://localhost:3000

# Set to 1 on the hosted process. The container entrypoint image sets this.
# It turns on the production checks (https APP_URL, real SESSION_SECRET).
# ADEL_SERVER=1

# Stripe TEST mode only. Live keys (sk_live_ / pk_live_ / rk_live_) are refused.
# Dashboard: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Photo storage. local writes UPLOAD_DIR on this machine (lost on many hosted deploys).
# s3 works with AWS S3, Cloudflare R2, Backblaze B2, and MinIO.
STORAGE_DRIVER=local
UPLOAD_DIR=data/uploads
# S3_BUCKET=adel-uploads
# S3_REGION=us-east-1
# S3_ENDPOINT=https://ACCOUNT.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=replace-with-an-access-key
# S3_SECRET_ACCESS_KEY=replace-with-a-secret-key
# S3_FORCE_PATH_STYLE=true

# Protects POST /api/cron/run (webhook retries, location retention, departure reminders).
# At least 16 characters. Generate one with: openssl rand -base64 32
# CRON_SECRET=replace-with-a-long-random-string

# info in production, debug otherwise. json lines when NODE_ENV=production or LOG_FORMAT=json.
# LOG_LEVEL=info
# LOG_FORMAT=json

# Set true in the container entrypoint. A platform release command can migrate instead.
# RUN_MIGRATIONS=true

# Optional. Create a token in Settings → API tokens, then:
# ADEL_API_BASE=http://localhost:3000
# ADEL_API_TOKEN=adel_...

# Dictation cleanup. The key stays in the environment and is never committed.
# Without a key, or when the value contains "replace", or when SPEECH_CLEANUP=off,
# the server skips the model. Dictionary spellings are still corrected, and the
# field stores the speech-engine transcript so Show original still works.
# SPEECH_CLEANUP=on
# SPEECH_CLEANUP_PROVIDER=openai
# SPEECH_CLEANUP_API_KEY=replace-with-a-provider-key
# SPEECH_CLEANUP_MODEL=gpt-4o-mini
# SPEECH_CLEANUP_BASE_URL=https://api.openai.com/v1
# Alternate provider: SPEECH_CLEANUP_PROVIDER=anthropic (uses the Anthropic messages API).

# docker-compose.prod.yml only. Not read by the Next.js app.
# POSTGRES_PASSWORD=replace-with-a-long-random-string
# MINIO_ROOT_PASSWORD=replace-with-a-long-random-string
# APP_DOMAIN=service.example.com
