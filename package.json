{
  "name": "adel-service",
  "private": true,
  "version": "0.1.0",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @adel/web dev",
    "build": "pnpm --filter @adel/web build",
    "start": "pnpm --filter @adel/web start",
    "test": "vitest run",
    "typecheck": "pnpm -r --filter \"./packages/*\" --filter @adel/web --if-present typecheck",
    "db:migrate": "pnpm --filter @adel/db migrate",
    "db:seed": "pnpm --filter @adel/db seed",
    "mcp": "pnpm --filter @adel/mcp start"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.0",
    "bcryptjs": "^3.0.2",
    "js-yaml": "^4.1.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
